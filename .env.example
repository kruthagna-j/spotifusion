# Firebase Web client configuration (from Firebase Console -> Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Spotifusion music backend
VITE_MUSIC_API_URL=https://spotifusion.onrender.com

# Spotify Connect (public client ID only; never put a Spotify client secret in VITE_ variables)
VITE_SPOTIFY_CLIENT_ID=

# Backend-only Astra configuration. Do NOT expose these as VITE_ variables.
ASTRA_API_KEY=
ASTRA_API_BASE_URL=
