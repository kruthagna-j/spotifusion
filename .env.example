# Firebase Web client configuration (from Firebase Console -> Project settings)
# Placeholder values keep the Android BuildConfig compilable in CI; runtime Firebase uses google-services.json when configured.
VITE_FIREBASE_API_KEY=placeholder
VITE_FIREBASE_AUTH_DOMAIN=placeholder
VITE_FIREBASE_PROJECT_ID=placeholder
VITE_FIREBASE_STORAGE_BUCKET=placeholder
VITE_FIREBASE_MESSAGING_SENDER_ID=placeholder
VITE_FIREBASE_APP_ID=placeholder

# Spotifusion music backend
VITE_MUSIC_API_URL=https://spotifusion.onrender.com

# Spotify Connect (public client ID only; never put a Spotify client secret in VITE_ variables)
VITE_SPOTIFY_CLIENT_ID=placeholder

# Backend-only Astra configuration. Do NOT expose these as VITE_ variables.
ASTRA_API_KEY=placeholder
ASTRA_API_BASE_URL=https://example.invalid
